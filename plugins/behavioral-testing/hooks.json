{
  "behavioral-testing-guards": {
    "enabled": true,
    "PostToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ./hooks/scripts/passing_test_reminder.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content|edit_file",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ./hooks/scripts/test_edit_guard.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
